# Режим LLM: mock (по умолчанию, без ключей) или openai (любой OpenAI-совместимый эндпоинт)
LLM_PROVIDER=mock

# Для LLM_PROVIDER=openai — любой OpenAI-совместимый шлюз (OpenAI, OpenRouter, DeepSeek, локальный vLLM/ollama)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Хранилище
DB_PATH=data/content_factory.db

# API (необязательно): если задан — мутирующие эндпоинты требуют заголовок x-api-key
API_TOKEN=

# Пайплайн
MAX_QA_ITERATIONS=3
QA_MIN_SCORE=70

# Публикация
PUBLISH_DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 (OAuth2 канала). Без ключей — режим dry-run.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Рендер видео из сценария
RENDER_VIDEO=false
VIDEO_DIR=data/videos
ASSETS_DIR=data/assets
MUSIC_VOLUME=0.16

# Озвучка: piper (офлайн нейро, по умолчанию) | sapi | yandex | elevenlabs
TTS_PROVIDER=piper
PIPER_MODEL=data/voices/ru_RU-irina-medium.onnx
# Yandex SpeechKit
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_VOICE=alena
# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
